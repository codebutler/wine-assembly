@@ -0,0 +1,122 @@
+'use strict';
+// Real adapter, target binding, depth storage, clear and state cache. Only GL
+// and color/texture allocation are mocked; observations are GL boundary state.
+const assert = require('assert');
+if (process.argv.includes('--revert')) {
+  const Module = require('module'), path = require('path');
+  const file = path.resolve(__dirname, '../lib/gpu-backend.js');
+  const m = new Module(file, module); m.filename = file; m.paths = module.paths;
+  m._compile(require('child_process').execFileSync('git', ['show',
+    '912cd44a9e0b4ffedf106ecc80031351773f5302:lib/gpu-backend.js'],
+    {stdio:['ignore','pipe','ignore'],maxBuffer:131072}).toString(), file);
+  require.cache[file] = m;
+}
+const {Device} = require('../lib/d3d9-backend');
+const {WebGLBackend} = require('../lib/gpu-backend');
+const Clear = require('../lib/render-clear');
+function fixture() {
+  const g = Object.create(WebGLBackend.prototype), clears = [], writes = [];
+  let fb = null, rb = null;
+  const state = {depth:1,stencil:0,color:[.1,.2,.3,.4]};
+  const gl = {
+    SCISSOR_TEST:1,COLOR_BUFFER_BIT:2,DEPTH_BUFFER_BIT:4,STENCIL_BUFFER_BIT:8,
+    FRAMEBUFFER_COMPLETE:9,NO_ERROR:0,DEPTH_COMPONENT16:16,DEPTH24_STENCIL8:24,
+    RENDERBUFFER_DEPTH_SIZE:30,RENDERBUFFER_STENCIL_SIZE:31,BLEND:32,
+    clearDepth(v){state.depth=v;writes.push(['depth',v]);},
+    clearStencil(v){state.stencil=v;writes.push(['stencil',v]);},
+    clearColor(...v){state.color=v;},
+    clear(mask){
+      if(mask&2)fb.color=[...state.color];
+      if(mask&4)fb.depth.depth=state.depth;
+      if(mask&8)fb.depth.stencil=state.stencil;
+      clears.push({mask,depth:state.depth,stencil:state.stencil,fb});
+    },
+    colorMask(...v){state.colorMask=v;},depthMask(v){state.depthMask=v;},
+    stencilMask(v){state.stencilMask=v;},scissor(...v){state.scissor=v;},
+    enable(cap){state['cap:'+cap]=true;},disable(cap){state['cap:'+cap]=false;},
+    viewport(...v){state.viewport=v;},depthRange(...v){state.range=v;},
+    createFramebuffer(){return {color:[.6,.7,.8,.9]};},
+    bindFramebuffer(_,v){fb=v;},framebufferTexture2D(){},
+    framebufferRenderbuffer(_a,_b,_c,v){fb.depth=v;},
+    createRenderbuffer(){return {};},bindRenderbuffer(_,v){rb=v;},
+    renderbufferStorage(_,format){rb.bits=format;},
+    getRenderbufferParameter(_,p){return p===30?rb.bits:rb.bits===24?8:0;},
+    checkFramebufferStatus(){return 9;},getError(){return 0;},
+    getParameter(){return 4096;},copyTexSubImage2D(){}
+  };
+  Object.assign(g,{gl,version:2,canvas:{width:4,height:4},_stateValues:new Map(),
+    _depthStores:new Map(),_colorResources:new Map(),_targets:new Map(),
+    _target:null,_implicitTarget:null,_targetBytes:0,targetBudget:1000000});
+  g._colorStorage=(width,height)=>({width,height,bytes:64,color:{},framebuffer:gl.createFramebuffer()});
+  g.createTexture=()=>({});g.uploadTexture2D=()=>{};
+  g.setTextureParameter=()=>{};g.bindTexture=()=>{};
+  const d=Object.create(Device.prototype);
+  Object.assign(d,{gpu:g,colorTargets:new Map(),depthTargets:new Map()});
+  const colors=[7,8].map(id=>({id,width:4,height:4,format:21}));
+  for(const color of colors){
+    g._colorResources.set(color.id,{...g._colorStorage(4,4),variants:new Map()});
+    d.colorTargets.set(color.id,{...color,revision:1});
+  }
+  // Warm clear-value and unrelated state through real cache methods.
+  gl.bindFramebuffer(null,gl.createFramebuffer());g.clear(null,0,.25,52);
+  g.setViewport(1,2,3,4);g.setDepthRange(.125,.875);g.setCapability(gl.BLEND,true);
+  return {g,d,gl,clears,writes,state,colors};
+}
+function checkUnrelated(f) {
+  assert.deepStrictEqual(f.state.viewport,[1,2,3,4]);
+  assert.deepStrictEqual(f.state.range,[.125,.875]);
+  assert.strictEqual(f.state['cap:'+f.gl.BLEND],true);
+  for(const [key,value] of [['viewport',[1,2,3,4]],['depthRange',[.125,.875]],['cap:32',[true]]])
+    assert.deepStrictEqual(f.g._stateValues.get(key),value);
+}
+let cases=0;
+if(!process.argv.includes('--implicit-only'))for(const [flags,format] of [[2,80],[2,75],[4,75],[6,75]]) {
+  for(const defaults of [false,true]) {
+    const f=fixture(),{g,d,clears,colors}=f;
+    const depth={id:11,width:4,height:4,format};
+    const requested=defaults?{}:{depth:.25,stencil:52};
+    const command=(color,attachment=depth)=>d.clearCommand(structuredClone(Clear.create({
+      flags,color:[1,0,0,1],colorAttachment:color,depthAttachment:attachment,...requested},4,4)));
+    const verify=()=>{
+      const last=clears.at(-1),store=g._target.depthStore.object;
+      assert.strictEqual(last.mask,flags===2?4:flags===4?8:12);
+      if(flags&2)assert.strictEqual(store.depth,defaults?1:.25,'fresh requested depth');
+      if(flags&4)assert.strictEqual(store.stencil,defaults?0:52,'fresh requested stencil');
+      if(!(flags&2))assert.strictEqual(store.depth,1,'stencil-only preserves initialized depth');
+      if(!(flags&4)&&format===75)assert.strictEqual(store.stencil,0,'depth-only preserves initialized stencil');
+      assert.deepStrictEqual(g._stateValues.get('clearDepth'),[f.state.depth]);
+      assert.deepStrictEqual(g._stateValues.get('clearStencil'),[f.state.stencil]);
+      // Named depth initialization and depth/stencil clears leave color alone.
+      assert.deepStrictEqual(last.fb.color,[.6,.7,.8,.9]);checkUnrelated(f);
+    };
+    command(colors[0]);verify();
+    const init=clears.at(-2);
+    assert.strictEqual(init.mask,format===80?4:12,'real first-use initializer retained');
+    assert.strictEqual(init.depth,1);assert.strictEqual(init.stencil,0);
+    const count=clears.length,writes=f.writes.length;
+    command(colors[0]);verify();
+    assert.strictEqual(clears.length,count+1,'existing target not reinitialized');
+    assert.strictEqual(f.writes.length,writes,'repeated clear uses matching cache');
+    command(colors[1],{...depth,id:12});verify();
+    command(colors[0]);verify();
+    // Switch through actual implicit binding, then back to the existing named target.
+    command(null,{...depth,id:13});
+    assert.strictEqual(clears.at(-1).mask,flags===2?4:flags===4?8:12);
+    command(colors[0]);verify();cases++;
+  }
+}
+// The other initializer wrote stencil 0 directly but omitted it from its cached
+// clear call. Isolate that same-boundary defect from the named-target mutation.
+{
+  const f=fixture(),{g,d,clears}=f;
+  const depth={id:21,width:4,height:4,format:75};
+  d.bindDepth(depth,null);
+  assert.strictEqual(clears.at(-1).stencil,0,'implicit storage initialized to zero');
+  assert.deepStrictEqual(g._stateValues.get('clearStencil'),[0],
+    'implicit initialization cache must match GL stencil');
+  d.clearCommand(Clear.create({color:[0,0,0,0],flags:4,stencil:52,depthAttachment:depth},4,4));
+  assert.strictEqual(g._target.depthStore.object.stencil,52,'implicit requested stencil');
+  assert.deepStrictEqual(g._stateValues.get('clearStencil'),[52]);
+  checkUnrelated(f);
+}
+console.log('PASS '+cases+' fresh named cases: depth-only/stencil-only/combined, defaults, repeat, switches; implicit cache; unrelated state');
