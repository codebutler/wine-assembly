      {
        "line": 4407,
        "text": "  ;; ---- pacing on the app's own game step ------------------------------------"
      },
      {
        "line": 4408,
        "text": "  ;; A present and a pump are both only proxies for a frame. StarCraft makes"
      },
      {
        "line": 4409,
        "text": "  ;; ~97 presents/s for ~17 displayed frames, and its loop pumps several times"
      },
      {
        "line": 4410,
        "text": "  ;; per game step, so either proxy paces the wrong event. When RE has found"
      },
      {
        "line": 4411,
        "text": "  ;; the function that advances the game one step (lib/apps.js"
      },
      {
        "line": 4412,
        "text": "  ;; perf.logicalFrame.address), the host hands it to this instance and the"
      },
      {
        "line": 4413,
        "text": "  ;; limiter paces exactly once per call of it."
      },
      {
        "line": 4414,
        "text": "  ;;"
      },
      {
        "line": 4415,
        "text": "  ;; How the step is seen, at no cost to any other block: $decode_block plants"
      },
      {
        "line": 4416,
        "text": "  ;; handler 476 ($th_logical_frame, operand = the address) as the FIRST op of"
      },
      {
        "line": 4417,
        "text": "  ;; the block whose entry EIP is $logical_frame_addr, and nowhere else. Every"
      },
      {
        "line": 4418,
        "text": "  ;; way into a block lands on its first op -- $run's lookup, the $branch_end /"
      },
      {
        "line": 4419,
        "text": "  ;; $jcc_end / $chain_end fast paths, a patched chain slot, an adjacent"
      },
      {
        "line": 4420,
        "text": "  ;; fall-through in an address-ordered run -- so the marker runs on every"
      }
