        "line": 4348,
        "text": "  ;; ---- which events are frame ends ----------------------------------------"
      },
      {
        "line": 4349,
        "text": "  ;; Every present site calls $present_frame_end, never $present_pace. A"
      },
      {
        "line": 4350,
        "text": "  ;; detected frame end is not always a logical frame. Fallout draws straight"
      },
      {
        "line": 4351,
        "text": "  ;; into its only surface, the primary. Each dirty rect it copies is a"
      },
      {
        "line": 4352,
        "text": "  ;; NULL-rect Lock, a memcpy and an Unlock (Falldemo.exe 0x489668), and one"
      },
      {
        "line": 4353,
        "text": "  ;; turn of its main loop copies five of them between two PeekMessage calls."
      },
      {
        "line": 4354,
        "text": "  ;; Pacing every Unlock sleeps five periods per game frame, and the walk"
      },
      {
        "line": 4355,
        "text": "  ;; took 1.6x longer at cap 60 (docs/re-notes/fallout-demo.md)."
      },
      {
        "line": 4356,
        "text": "  ;;"
      },
      {
        "line": 4357,
        "text": "  ;; A Win32 game loop pumps its message queue once per turn, so a frame is"
      },
      {
        "line": 4358,
        "text": "  ;; bounded by the pump: the frame ends between two PeekMessage/GetMessage"
      },
      {
        "line": 4359,
        "text": "  ;; calls are one frame. After a thread has been seen to pump between frame"
      },
      {
        "line": 4360,
        "text": "  ;; ends, a frame end only marks the frame pending, and the pump that follows"
      },
      {
        "line": 4361,
        "text": "  ;; paces it once ($present_pump). Until then, or on a thread that presents"
      },
      {
        "line": 4362,
        "text": "  ;; and never pumps (a render thread, a loading screen), each frame end paces"
      },
      {
        "line": 4363,
        "text": "  ;; at once, as before. For a loop that presents once per pump the cadence is"
      },
      {
        "line": 4364,
        "text": "  ;; the same either way. Per instance, so per guest thread."
      },
      {
        "line": 4365,
        "text": "  ;;"
      },
      {
        "line": 4366,
        "text": "  ;; The counters feed run.js --present-frames, which reports detected frame"
      },
      {
        "line": 4367,
        "text": "  ;; ends against pump-bounded frames and flags a ratio above 1."
      },
      {
        "line": 4368,
        "text": "  (global $present_frame_pending (mut i32) (i32.const 0)) ;; a frame end since the last pump"
      },
      {
        "line": 4369,
        "text": "  (global $present_pump_bounded (mut i32) (i32.const 0))  ;; 1 once this thread pumps between frames"
      },
      {
        "line": 4370,
        "text": "  (global $present_frame_ends (mut i32) (i32.const 0))    ;; detected frame ends, capped or not"
      },
      {
        "line": 4371,
        "text": "  (global $present_pump_frames (mut i32) (i32.const 0))   ;; pumps that closed >= 1 frame end"
      },
      {
        "line": 4372,
        "text": ""
      },
      {
        "line": 4373,
        "text": "  (func $present_frame_end"
      },
      {
        "line": 4374,
        "text": "    (global.set $present_frame_ends (i32.add (global.get $present_frame_ends) (i32.const 1)))"
      },
      {
        "line": 4375,
        "text": "    (global.set $present_frame_pending (i32.const 1))"
      },
      {
        "line": 4376,
        "text": "    (if (global.get $present_pump_bounded) (then (return)))"
      },
      {
        "line": 4377,
        "text": "    (if (call $logical_frame_owns) (then (return)))"
      },
      {
        "line": 4378,
        "text": "    (call $present_pace))"
      },
      {
        "line": 4379,
        "text": ""
      },
      {
        "line": 4380,
        "text": "  ;; Called at the top of PeekMessage/GetMessage. Returns 1 when it parked the"
      },
      {
        "line": 4381,
        "text": "  ;; call for the pace's sleep: the stdcall frame is untouched and EIP is back"
      },
      {
        "line": 4382,
        "text": "  ;; on the thunk ($vblank_block's contract), so the same call runs again after"
      },
      {
        "line": 4383,
        "text": "  ;; the sleep. Its message is read after the sleep, not before it. The frame"
      },
      {
        "line": 4384,
        "text": "  ;; is no longer pending then, so the second run does not pace again."
      },
      {
        "line": 4385,
        "text": "  (func $present_pump (result i32)"
      },
      {
        "line": 4386,
        "text": "    (local $slept i32)"
      },
      {
        "line": 4387,
        "text": "    (if (i32.eqz (global.get $present_frame_pending)) (then (return (i32.const 0))))"
      },
      {
        "line": 4388,
        "text": "    (global.set $present_frame_pending (i32.const 0))"
      },
      {
        "line": 4389,
        "text": "    (global.set $present_pump_frames (i32.add (global.get $present_pump_frames) (i32.const 1)))"
      },
      {
        "line": 4390,
        "text": "    ;; The first pump after a frame end is when this thread's loop shape is"
      },
      {
        "line": 4391,
        "text": "    ;; learned. That frame was already paced at its end."
      },
      {
        "line": 4392,
        "text": "    (if (i32.eqz (global.get $present_pump_bounded))"
      },
      {
        "line": 4393,
        "text": "      (then"
      },
      {
        "line": 4394,
        "text": "        (global.set $present_pump_bounded (i32.const 1))"
      },
      {
        "line": 4395,
        "text": "        (return (i32.const 0))))"
      },
      {
        "line": 4396,
        "text": "    ;; The game step paces this thread's frames instead ($th_logical_frame)."
      },
      {
        "line": 4397,
        "text": "    (if (call $logical_frame_owns) (then (return (i32.const 0))))"
      },
      {
        "line": 4398,
        "text": "    (local.set $slept (global.get $sleep_yielded))"
      },
      {
