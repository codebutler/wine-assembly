[Unit]
Description=Wine Assembly Telegram bridge watchdog
After=network-online.target wine-ops.service
Wants=network-online.target wine-ops.service

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/wine-assembly
RuntimeDirectory=wine-telegram
RuntimeDirectoryMode=0700
Environment=TELEGRAM_WATCHDOG_LOCK=/run/wine-telegram/watchdog.lock
ExecStart=/usr/bin/env node ops/telegram-watchdog.js
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
