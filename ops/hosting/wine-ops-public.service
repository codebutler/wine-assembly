[Unit]
Description=Wine Assembly HTTPS password gateway
After=network.target wine-ops.service
Wants=wine-ops.service

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/wine-assembly
ExecStart=/usr/bin/env node ops/hosting/public-server.js /home/user/.config/wine-ops/access.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
