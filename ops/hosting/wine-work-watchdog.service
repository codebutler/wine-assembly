[Unit]
Description=Wine Assembly actionable-work watchdog
After=network-online.target wine-ops.service
Wants=wine-ops.service

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/wine-assembly
ExecStart=/usr/bin/env node ops/work-watchdog.js
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
